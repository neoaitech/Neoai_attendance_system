# VisionAttend Environment Configuration Example
PROJECT_NAME="VisionAttend Pro - AI Classroom Attendance System"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Detection & Recognition Calibration
DEFAULT_TOLERANCE=0.50
STRICT_TOLERANCE=0.58
RELAXED_TOLERANCE=0.42
DEFAULTER_THRESHOLD_PERCENT=75.0

# Database Configuration (Leave empty or default for local SQLite)
# For Supabase / Render PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Cloud Storage (Optional: For storing student & class photos in Supabase 1GB free bucket)
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-ANON-OR-SERVICE-ROLE-KEY]
# SUPABASE_BUCKET=attendance-media
