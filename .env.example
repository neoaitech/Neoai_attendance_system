# ===================================================================
# VisionAttend Production Environment Variables
# NeoAI Tech - Azure Ubuntu VM Deployment
# ===================================================================

# 1. Security (Generate a fresh 32-byte secret: openssl rand -hex 32)
SECRET_KEY=replace-with-secure-32-byte-hex-key-from-openssl

# 2. Database Configuration
# Option A: Standalone SQLite inside Docker persistent runtime volume
DATABASE_URL=sqlite:////app/database/attendance.db
# Option B: Managed PostgreSQL / Supabase
# DATABASE_URL=postgresql://postgres.USER:PASSWORD@HOST:5432/postgres

# 3. Application Execution Settings
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# 4. Storage & Media Runtime Volumes
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
STUDENT_PHOTOS_DIR=/app/data/uploads/students
SESSION_PHOTOS_DIR=/app/data/uploads/sessions
UNKNOWN_FACES_DIR=/app/data/uploads/unknown_faces
REPORTS_DIR=/app/data/reports_cache
BACKUPS_DIR=/app/database/backups
