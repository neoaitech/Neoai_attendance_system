<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-08-19T05:24:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="clean-day2" name="Day 2 Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AI Smart Attendance System — High-Level Architecture (Day 2)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1530" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Uploaded classroom/group photo workflow • Detection → Recognition → Attendance → Reporting" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1530" height="30" as="geometry" /></mxCell><mxCell id="actor" value="&lt;b&gt;1. ACTOR / ENTRY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Teacher / Authorized User&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Login&lt;br&gt;• Start attendance session&lt;br&gt;• Upload classroom/group photo&lt;br&gt;• Review results&lt;br&gt;• Confirm/correct attendance&lt;br&gt;• View reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#4A78C2;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="300" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;2. PRESENTATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Web UI / Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Secure login&lt;br&gt;• Dashboard&lt;br&gt;• Student registration&lt;br&gt;• Photo upload&lt;br&gt;• Recognition result screen&lt;br&gt;• Attendance review&lt;br&gt;• Reports &amp; filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FF;strokeColor=#4A78C2;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="335" y="130" width="260" height="300" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;3. APPLICATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Backend / REST API&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Authentication &amp; authorization&lt;br&gt;• Request/file validation&lt;br&gt;• Session management&lt;br&gt;• Student/class operations&lt;br&gt;• AI orchestration&lt;br&gt;• Attendance confirmation&lt;br&gt;• Report APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#5C9B70;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="630" y="130" width="270" height="300" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;4. AI PROCESSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Photo-based pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Stage 1: Face detection &amp; alignment&lt;br&gt;• Stage 2: Recognition / verification&lt;br&gt;• Match + confidence score&lt;br&gt;• Recognized / unknown decision&lt;br&gt;• Low-confidence / unknown → manual review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#C58B4A;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="935" y="130" width="285" height="300" as="geometry" /></mxCell><mxCell id="data" value="&lt;b&gt;5. DATA &amp; REPORTING&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Application Database&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Students&lt;br&gt;• Classes&lt;br&gt;• Sessions&lt;br&gt;• Attendance&lt;br&gt;• UnknownFaces&lt;br&gt;&lt;br&gt;&lt;b&gt;Reporting&lt;/b&gt;&lt;br&gt;• Daily/session summary&lt;br&gt;• Student history&lt;br&gt;• Class/date filters&lt;br&gt;• Excel/PDF export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#8C70B0;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1255" y="130" width="350" height="300" as="geometry" /></mxCell><mxCell id="main1" value="user action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78C2;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="actor" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main2" value="HTTPS / API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78C2;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="frontend" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main3" value="photo + session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C58B4A;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="backend" target="ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main4" value="attendance record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8C70B0;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="ai" target="data"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pipeline_title" value="AI Decision Pipeline — Detailed View" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="500" height="35" as="geometry" /></mxCell><mxCell id="input" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Uploaded classroom/group photo&lt;br&gt;&lt;font style='font-size:10px'&gt;No live-video requirement in current scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#607D8B;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="225" height="105" as="geometry" /></mxCell><mxCell id="detect" value="&lt;b&gt;Stage 1 — Detection &amp; Alignment&lt;/b&gt;&lt;br&gt;&lt;br&gt;MediaPipe / selected detector&lt;br&gt;• Detect faces&lt;br&gt;• Landmarks&lt;br&gt;• Alignment&lt;br&gt;• Face crops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#C58B4A;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="300" y="510" width="260" height="125" as="geometry" /></mxCell><mxCell id="recognize" value="&lt;b&gt;Stage 2 — Recognition / Verification&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeepFace + selected recognition backend&lt;br&gt;• Compare with registered students&lt;br&gt;• Confidence score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#C58B4A;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="595" y="510" width="280" height="125" as="geometry" /></mxCell><mxCell id="decision" value="&lt;b&gt;Attendance Decision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recognized → mark present&lt;br&gt;Unknown / low confidence → manual review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#5C9B70;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="910" y="510" width="245" height="125" as="geometry" /></mxCell><mxCell id="persist" value="&lt;b&gt;Persist Result&lt;/b&gt;&lt;br&gt;&lt;br&gt;Session + student + attendance status&lt;br&gt;Unknown/review state where applicable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#8C70B0;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1190" y="510" width="265" height="125" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;Teacher Review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Review low-confidence/unknown faces and confirm or correct attendance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C56A6A;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=10;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1490" y="510" width="120" height="125" as="geometry" /></mxCell><mxCell id="p1" value="photo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#607D8B;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="input" target="detect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2" value="face crops" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C58B4A;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="detect" target="recognize"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3" value="match + confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C58B4A;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="recognize" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4" value="attendance status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8C70B0;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="decision" target="persist"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5" value="review item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C56A6A;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="decision" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6" value="confirmed/corrected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C56A6A;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="review" target="persist"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;Application Result Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI result → Backend API → Recognition/Attendance Review UI → Teacher confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FF;strokeColor=#4A78C2;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="740" height="105" as="geometry" /></mxCell><mxCell id="reports" value="&lt;b&gt;Reporting Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;Database → Backend report API → Reports UI → Teacher&lt;br&gt;Daily/session summary • history • filters • Excel/PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#8C70B0;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="815" y="665" width="795" height="105" as="geometry" /></mxCell><mxCell id="r1" value="AI result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78C2;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="ai" target="result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="UI result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78C2;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="result" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="report data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8C70B0;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="data" target="reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="report UI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8C70B0;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="reports" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="security" value="&lt;b&gt;SECURITY &amp; DATA PROTECTION — CROSS-CUTTING&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Authentication &amp; authorization for protected operations &amp;nbsp;&amp;nbsp; • Validate uploaded files and request fields &amp;nbsp;&amp;nbsp; • Keep passwords, real student photos, raw embeddings, and sensitive reports out of Git &amp;nbsp;&amp;nbsp; • Store sensitive artifacts only in approved private/local storage &amp;nbsp;&amp;nbsp; • Restrict access to attendance and reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C56A6A;strokeWidth=2;align=center;verticalAlign=top;spacing=14;fontSize=11;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1570" height="125" as="geometry" /></mxCell><mxCell id="note" value="Technology note: Backend can use Flask/FastAPI; frontend React; development DB SQLite with PostgreSQL as production candidate; AI stack includes MediaPipe/OpenCV and DeepFace. Final model/configuration is subject to empirical testing on the project dataset." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#667085;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1530" height="55" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Scope:&lt;/b&gt; Day-2 high-level architecture • Current attendance input is an uploaded classroom/group photo • No live-video attendance in current scope" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#475467;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1530" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>